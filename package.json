{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "check:dev": "node scripts/check-dev-env.mjs",
        "check:admin-vite": "php artisan test --filter=AdminViteIsolation",
        "dev": "npm run check:dev && vite --host 127.0.0.1 --port 4173",
        "dev:stack": "npm run check:dev && concurrently -c \"#93c5fd,#c4b5fd\" \"php artisan serve --host=127.0.0.1 --port=8000\" \"vite --host 127.0.0.1 --port 4173\" --names=laravel,vite",
        "perf:bundle": "node scripts/perf-bundle.mjs",
        "perf:api": "php scripts/bench-api.php --iterations=25",
        "perf:http": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bench-http.ps1",
        "test:unit": "node --test tests/unit/*.test.mjs",
        "test:editor-focus": "node scripts/test-page-editor-focus.mjs"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "playwright": "^1.60.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@vitejs/plugin-vue": "^6.0.6",
        "pinia": "^3.0.4",
        "vue": "^3.5.33",
        "vue-router": "^5.0.6"
    }
}
